# Copy to .env (docker compose reads it automatically)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Public demo: block create/update/delete
READ_ONLY=0
# Load ./data into Redis on startup when the database is empty
AUTO_LOAD=1
# Link shown in the footer
REPO_URL=https://github.com/<you>/<repo>

# Local development only
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
DASHBOARD_CACHE_SECONDS=30
